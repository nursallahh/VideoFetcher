<Window
    x:Class="VideoFetcher.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="Video Fetcher">

    <Grid Background="#07090F">
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Sekme Çubuğu & Reklam Kalkanı -->
        <Grid Grid.Row="0" Padding="10,4" Background="#0A0D14" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image Source="ms-appx:///Assets/AppLogo.png" Width="24" Height="24" VerticalAlignment="Center" />

            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="TabsPanel" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" />
            </ScrollViewer>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Content="+ Yeni Sekme" Click="OnNewTabClick" Padding="10,4" FontSize="11" CornerRadius="8" />
                <ToggleButton x:Name="AdBlockToggle" Content="🛡️ Reklam Kalkanı: Açık" IsChecked="True" Click="OnAdBlockToggleClick" Padding="10,4" FontSize="11" CornerRadius="8" />
            </StackPanel>
        </Grid>

        <!-- Adres & Araç Çubuğu -->
        <Grid Grid.Row="1" Padding="14,6" ColumnSpacing="10" Background="#0F131D">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Content="←" Click="OnBackClick" CornerRadius="8" />
                <Button Content="→" Click="OnForwardClick" CornerRadius="8" />
                <Button Content="↻" Click="OnReloadClick" CornerRadius="8" />
            </StackPanel>

            <TextBox x:Name="AddressBox" Grid.Column="1" PlaceholderText="Google'da ara veya site adresi yaz..." KeyDown="OnAddressKeyDown" VerticalAlignment="Center" CornerRadius="16" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button x:Name="BookmarksButton" Content="⭐ Yer İmleri" CornerRadius="16">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Width="320" Spacing="8">
                                <Grid>
                                    <TextBlock Text="Yer İmleri" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                    <Button Content="+ Bu Siteyi Ekle" HorizontalAlignment="Right" FontSize="11" Padding="8,4" Click="OnAddBookmarkClick" />
                                </Grid>
                                <ListView x:Name="BookmarksList" MaxHeight="260" SelectionChanged="OnBookmarkSelected" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="HistoryButton" Content="🕒 Geçmiş" CornerRadius="16">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Width="340" Spacing="8">
                                <Grid>
                                    <TextBlock Text="Son Ziyaret Edilen Siteler" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                    <Button Content="Temizle" HorizontalAlignment="Right" FontSize="11" Padding="8,4" Click="OnClearHistoryClick" />
                                </Grid>
                                <ListView x:Name="HistoryList" MaxHeight="320" SelectionChanged="OnHistoryItemSelected" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="YtDlpScanButton" Content="⚡ yt-dlp Tara" Click="OnYtDlpScanClick" CornerRadius="16" />
                <Button x:Name="UpdatePillButton" Content="🆕 Güncelleme Var" Click="OnUpdatePillClick" Visibility="Collapsed" CornerRadius="16" Background="#2638BDF8" Foreground="#7DD3FC" BorderBrush="#6038BDF8" />
                <Button x:Name="RadarPillButton" Content="● Video Hazır" Click="OnToggleHudClick" Visibility="Collapsed" CornerRadius="16" Background="#1A10B981" Foreground="#6EE7B7" BorderBrush="#4D10B981" />
                <Button x:Name="LibraryButton" Content="📚 Kütüphane" Click="OnRefreshLibraryClick" CornerRadius="16">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Width="360" Spacing="8">
                                <Grid>
                                    <TextBlock Text="İndirilen Videolar" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                        <Button Content="Oynat" FontSize="11" Padding="8,4" Click="OnPlayLibraryItemClick" />
                                        <Button Content="Sil" FontSize="11" Padding="8,4" Click="OnDeleteLibraryItemClick" />
                                        <Button Content="Klasör" FontSize="11" Padding="8,4" Click="OnOpenLibraryFolderClick" />
                                    </StackPanel>
                                </Grid>
                                <ListView x:Name="LibraryList" MaxHeight="320" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- WebView2 Sekme Alanı & Yüzen HUD -->
        <Grid Grid.Row="2">
            <Grid x:Name="BrowserContainer" />

            <Border x:Name="FloatingHud"
                    Visibility="Collapsed"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,16,18,0"
                    Width="425"
                    MaxHeight="680"
                    Padding="18"
                    CornerRadius="20"
                    Background="#EB121623"
                    BorderBrush="#26FFFFFF"
                    BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <Grid>
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="HudStatusText" Text="● Kayıpsız İndirmeye Hazır" Foreground="#6EE7B7" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock x:Name="HudTitleText" Text="Video" Foreground="White" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnToggleHudClick" Background="Transparent" BorderThickness="0" Foreground="#94A3B8" />
                        </Grid>

                        <ComboBox x:Name="QualitySelector" Header="Çözünürlük / Kalite Seçimi (Alaka Sıralı)" HorizontalAlignment="Stretch" CornerRadius="10" SelectionChanged="OnQualitySelectionChanged" />

                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="SubtitleLangBox" Header="Dil" SelectedIndex="0" Width="95" CornerRadius="10">
                                <ComboBoxItem Content="TR + EN" Tag="tr,en" />
                                <ComboBoxItem Content="Türkçe" Tag="tr" />
                                <ComboBoxItem Content="English" Tag="en" />
                                <ComboBoxItem Content="Deutsch" Tag="de" />
                                <ComboBoxItem Content="Français" Tag="fr" />
                                <ComboBoxItem Content="Español" Tag="es" />
                            </ComboBox>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBox x:Name="SubtitleQueryBox" PlaceholderText="Yapım adı (örn. The Vampire Diaries S07E09)" FontSize="11" CornerRadius="8" />
                                <ComboBox x:Name="SubtitleSelector" PlaceholderText="Altyazı seçin" HorizontalAlignment="Stretch" CornerRadius="10" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="Ara" VerticalAlignment="Bottom" Click="OnSearchSubtitlesClick" CornerRadius="10" />
                        </Grid>

                        <ComboBox x:Name="VideoEnhanceMode" Header="Görüntü &amp; Renk Profili" SelectedIndex="0" HorizontalAlignment="Stretch" CornerRadius="10">
                            <ComboBoxItem Content="Kayıpsız + Otomatik HDR→SDR (Anında • Önerilen)" Tag="hdr_only" />
                            <ComboBoxItem Content="Sinema İyileştirme (Netlik + Canlı Renk • Yavaş)" Tag="cinema" />
                            <ComboBoxItem Content="Kayıpsız Orijinal (-c copy)" Tag="raw" />
                        </ComboBox>

                        <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Spacing="4">
                            <TextBlock x:Name="HudProgressLabel" Text="Hazırlanıyor..." Foreground="#7DD3FC" FontSize="11" TextWrapping="Wrap" />
                            <ProgressBar x:Name="HudProgress" Minimum="0" Maximum="100" Value="0" />
                        </StackPanel>

                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="HudDownloadButton" Content="En Yüksek Hızda İndir" HorizontalAlignment="Stretch" CornerRadius="12" Padding="0,10" Background="White" Foreground="#090B10" FontWeight="SemiBold" Click="OnDownloadClick" />
                            <Button x:Name="HudQueueButton" Grid.Column="1" Content="+ Kuyruk" CornerRadius="12" Padding="10,10" Click="OnAddToQueueClick" />
                            <Button x:Name="HudCancelButton" Grid.Column="2" Content="İptal" Visibility="Collapsed" CornerRadius="12" Padding="12,10" Click="OnCancelDownloadClick" />
                            <Button x:Name="HudResetButton" Grid.Column="3" Content="↻" Visibility="Collapsed" CornerRadius="12" Padding="10,10" Click="OnResetDownloadClick" />
                        </Grid>

                        <Expander x:Name="AdvancedExpander" Header="Kuyruk (0) • Zaman Kırpma • Teknik Günlük" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="8" Padding="0,6,0,0">
                                <CheckBox x:Name="BingeModeCheck" Content="Otomatik Bölüm İndir (Binge Modu)" FontSize="11" Foreground="#CBD5E1" />
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TrimStartBox" Header="Başlangıç (-ss)" PlaceholderText="00:00:00" FontSize="11" CornerRadius="8" />
                                    <TextBox x:Name="TrimEndBox" Grid.Column="1" Header="Bitiş (-to)" PlaceholderText="00:05:00" FontSize="11" CornerRadius="8" />
                                </Grid>

                                <ListView x:Name="QueueList" MaxHeight="95" />

                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="DiagnosticLogBox" IsReadOnly="True" PlaceholderText="Teknik günlük / hata detayları..." FontSize="10" MaxHeight="70" TextWrapping="Wrap" CornerRadius="8" />
                                    <Button Grid.Column="1" Content="Kopyala" VerticalAlignment="Top" FontSize="11" Click="OnCopyDiagnosticsClick" CornerRadius="8" />
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <Expander x:Name="OtherStreamsExpander" Header="Diğer / Düşük Alakalı Akışlar (0)" HorizontalAlignment="Stretch">
                            <ListView x:Name="OtherStreamsList" MaxHeight="110" SelectionChanged="OnOtherStreamSelected" />
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
